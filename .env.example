# ============================================================================
# RAGLite / WeKnow — 配置模板
#
# 用法：
#   1. 复制本文件为 .env：  cp .env.example .env
#   2. 把下面带 <...> 的占位符换成你自己的值
#   3. 直接运行即可。模型能力（上下文长度、向量维度）无需手填，
#      首次运行会自动探测并写回 .env（见文件末尾说明）。
#
# .env 已在 .gitignore 中，不会被提交。
# ============================================================================


# ---------------------------------------------------------------------------
# 1. LLM（生成模型）—— 必填
#
# 走 OpenAI 兼容协议的端点读 OPENAI_API_BASE + OPENAI_API_KEY。
# 模型名必须带 litellm 的 provider 前缀，例如：
#   openai/<model>      通用 OpenAI 兼容端点（配合 OPENAI_API_BASE）
#   dashscope/<model>   阿里云百炼（读 DASHSCOPE_API_KEY）
#   ollama/<model>      本地 ollama（读 OLLAMA_API_BASE）
#   anthropic/<model>   或任何 litellm 内置 provider
# ---------------------------------------------------------------------------
OPENAI_API_BASE=https://api.llm.ustc.edu.cn/v1
OPENAI_API_KEY=<你的 API Key>
RAG_LLM_MODEL=openai/qwen3.8-chat


# ---------------------------------------------------------------------------
# 2. Embedder（嵌入模型）—— 必填
#
# 可以跟 LLM 用完全不同的端点和 Key：provider 前缀决定读哪个环境变量。
# 例：LLM 在 USTC 端点，embedder 在阿里云百炼，两者互不影响。
#
# 注意：嵌入模型的向量维度一旦入库就固定了。换 embedder 会导致维度变化，
#       必须重建数据库，否则检索会失败。
# ---------------------------------------------------------------------------
DASHSCOPE_API_KEY=<你的嵌入模型 API Key>
RAG_EMBED_MODEL=dashscope/qwen3.7-text-embedding-flash

# 每次嵌入请求最多带多少条文本。多数厂商网关对此有上限，超了直接 400：
#   DashScope（阿里云百炼）实测上限 25 条（报错文本写的是 20，是错的）。
# 不填则按 provider 前缀自动取（dashscope=25，其它=96）；遇到没见过的网关，
# 代码会把被拒的批次对半拆开重试，所以不填也能跑通。
RAG_EMBEDDER_BATCH_SIZE=25


# ---------------------------------------------------------------------------
# 3. 数据库 —— 二选一
#
#   duckdb:///相对或绝对路径.db            默认后端；vss 扩展给 HNSW，fts 扩展给 BM25
#   postgresql+pg8000://user:pw@host/db    需要目标库装好 pgvector 扩展
#
# 建议用绝对路径。相对路径的解析结果取决于进程的工作目录，容易在启动方式变化时
# 悄悄换库（表现为"刚入库的文档搜不到"）；系统盘写满还会让入库直接失败。
# ---------------------------------------------------------------------------
RAG_DB_URL=duckdb:///E:/weknow/weknow.db


# ---------------------------------------------------------------------------
# 4. 重排器（可选）
#
# 留空（=后面什么都不写）表示关闭重排。这适合离线环境，因为默认重排器会在
# 首次使用时从 Hugging Face 下载模型权重。
# 想开启就填 litellm 支持的 rerank 模型名。
# ---------------------------------------------------------------------------
RAG_RERANKER=


# ---------------------------------------------------------------------------
# 5. 网络（离线 / 受限网络环境需要）
#
# HF_ENDPOINT                      Hugging Face 镜像，用于下载分句模型等权重
# LITELLM_LOCAL_MODEL_COST_MAP     禁止 litellm 联网拉取模型价格表（启动更快）
# ---------------------------------------------------------------------------
HF_ENDPOINT=https://hf-mirror.com
LITELLM_LOCAL_MODEL_COST_MAP=True


# ---------------------------------------------------------------------------
# 6. 模型能力声明（一般不需要填）
#
# litellm 内置价格表里没有的模型（私有端点、刚发布的新模型），litellm 无法告知
# RAGLite 三项能力，于是退回保守默认值：上下文按 2048 算、向量维度靠一次额外
# 网络请求实测。填上这两项可以避免。
#
# 好消息：不填也能跑。首次运行时会自动探测端点并写回本文件，无需手动维护。
# 想手动指定（例如端点不允许探测请求）就取消下面的注释。
# ---------------------------------------------------------------------------
# RAG_LLM_CONTEXT_SIZE=131072
# RAG_EMBEDDER_DIMENSION=1024

# Maximum LLM round-trips in the agentic retrieval loop. Each round is a full completion, so on a
# slow endpoint this dominates the time to first token: measured at ~46 chars/s, 3 rounds took
# 33.5 s before the first answer token and 1 round took 12.1 s, with the same chunks retrieved.
RAG_AGENTIC_ITERATIONS=3
